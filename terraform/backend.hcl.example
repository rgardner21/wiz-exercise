# Copy to backend.hcl and fill in. Create the bucket and table once by hand:
#
#   aws s3api create-bucket --bucket my-tfstate-bucket --region us-east-1
#   aws s3api put-bucket-versioning --bucket my-tfstate-bucket \
#       --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name my-tfstate-locks \
#       --attribute-definitions AttributeName=LockID,AttributeType=S \
#       --key-schema AttributeName=LockID,KeyType=HASH \
#       --billing-mode PAY_PER_REQUEST
#
# Then: terraform init -backend-config=backend.hcl

bucket         = "my-tfstate-bucket"
key            = "wiz-exercise/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "my-tfstate-locks"
encrypt        = true
